# Sem MONGODB_URI, npm run dev inicia MongoDB real em work/data.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=crm_comercial
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=4310
HOST=127.0.0.1
# Produção: NODE_ENV=production, APP_ORIGIN=https://seu-dominio
# e conexão autenticada MongoDB no ambiente do provedor.
